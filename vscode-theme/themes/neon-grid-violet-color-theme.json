  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#867d9e",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier",
        "keyword.other",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.word"
      ],
      "settings": {
        "foreground": "#ff7468"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.type"
      ],
      "settings": {
        "foreground": "#a9bdd8"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#a9bdd8"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#f2dc50"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "constant.numeric.decimal",
        "constant.numeric.hex"
      ],
      "settings": {
        "foreground": "#62e0b4"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant",
        "constant.language",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#ffbf8a"
      }
    },
    {
      "name": "Escape",
      "scope": [
        "constant.character.escape",
        "string.regexp constant.character.escape"
      ],
      "settings": {
        "foreground": "#ff9a5c"
      }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp",
        "string.regexp keyword.operator"
      ],
      "settings": {
        "foreground": "#ff9a8f"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#4fe0ee"
      }
    },
    {
      "name": "Macros",
      "scope": [
        "entity.name.function.macro",
        "entity.name.function.preprocessor",
        "meta.attribute.rust",
        "entity.name.function.decorator",
        "meta.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#ffbf8a"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "support.type",
        "support.type.primitive",
        "storage.type.primitive",
        "storage.type.rust",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#c77dff"
      }
    },
    {
      "name": "Classes",
      "scope": [
        "entity.name.class",
        "entity.name.type.class",
        "entity.name.type.struct",
        "entity.name.type.enum",
        "entity.name.type.interface",
        "entity.name.namespace",
        "entity.name.module"
      ],
      "settings": {
        "foreground": "#e0b4ff"
      }
    },
    {
      "name": "Lifetimes",
      "scope": [
        "storage.modifier.lifetime.rust",
        "entity.name.type.lifetime"
      ],
      "settings": {
        "foreground": "#ff9a5c"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#e6f0f2"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameters variable"
      ],
      "settings": {
        "foreground": "#e0b4ff",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.type.property-name",
        "meta.object-literal.key",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#9fd3de"
      }
    },
    {
      "name": "this/self",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.special.self.python",
        "variable.language.special.cls.python",
        "variable.parameter.function.language.special.self.python",
        "variable.parameter.function.language.special.cls.python",
        "variable.language.self.rust"
      ],
      "settings": {
        "foreground": "#c77dff",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Python modules",
      "scope": [
        "support.module",
        "support.module.python",
        "entity.name.namespace",
        "meta.import.python entity.name.namespace",
        "support.other.module",
        "entity.name.type.module"
      ],
      "settings": {
        "foreground": "#6ab8ff"
      }
    },
    {
      "name": "Python builtins",
      "scope": [
        "support.function.builtin",
        "support.function.builtin.python",
        "support.function.magic.python",
        "support.type.python",
        "support.variable.magic.python"
      ],
      "settings": {
        "foreground": "#8fe8f2"
      }
    },
    {
      "name": "Python classes",
      "scope": [
        "entity.name.type.class.python",
        "support.class",
        "support.class.python",
        "entity.other.inherited-class.python"
      ],
      "settings": {
        "foreground": "#e0b4ff"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#ff7468"
      }
    },
    {
      "name": "Tag punctuation",
      "scope": [
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#a9bdd8"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#ff9a5c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json",
        "meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#9fd3de"
      }
    },
    {
      "name": "JSON strings",
      "scope": [
        "meta.structure.dictionary.value.json string.quoted.double.json"
      ],
      "settings": {
        "foreground": "#f2dc50"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#fcee0a",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "meta.link.inline.markdown"
      ],
      "settings": {
        "foreground": "#8fe8f2"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block.markdown",
        "markup.raw.block"
      ],
      "settings": {
        "foreground": "#f2dc50"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#e0b4ff",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#e6f0f2",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown quote/list",
      "scope": [
        "markup.quote",
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": "#a9bdd8"
      }
    },
    {
      "name": "Shell variables",
      "scope": [
        "variable.other.normal.shell",
        "variable.other.positional.shell",
        "punctuation.definition.variable.shell",
        "variable.other.special.shell"
      ],
      "settings": {
        "foreground": "#e0b4ff"
      }
    },
    {
      "name": "Shell commands",
      "scope": [
        "support.function.builtin.shell",
        "entity.name.command.shell"
      ],
      "settings": {
        "foreground": "#4fe0ee"
