# Purrgotchi LLM provider configuration
#
# Copy this file to .env in the same directory and uncomment ONE provider block.
# .env is gitignored. PURR_LLM_PROVIDER is required for any LLM feature; without
# it, purrgotchi falls back to static speech (no errors, no prompts).
#
# Process-level env vars (e.g. shell-exported) take precedence over .env values.

# --- Anthropic ---
# PURR_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-api03-...
# PURR_LLM_MODEL=claude-haiku-4-5

# --- Gemini ---
# PURR_LLM_PROVIDER=gemini
# GEMINI_API_KEY=...
# PURR_LLM_MODEL=gemini-2.5-flash

# --- OpenAI ---
# PURR_LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# PURR_LLM_MODEL=gpt-4o-mini

# Optional: enables ~/.claude/purrgotchi/debug.log entries for LLM calls
# PURR_DEBUG=1
